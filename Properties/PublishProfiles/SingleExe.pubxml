<Project>
  <PropertyGroup>
    <!--
      Profile ini dipakai oleh: dotnet publish -p:PublishProfile=SingleExe
      Hasilnya satu file .exe portable, tidak butuh .NET runtime terinstall di PC target.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed> <!-- WPF belum full-support trimming, jangan diaktifkan -->
    <Configuration>Release</Configuration>
  </PropertyGroup>
</Project>
