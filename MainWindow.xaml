<Window x:Class="PCOptimizerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sigma Optimizer" Height="680" Width="1040"
        Background="#0A0D11" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Toggle switch, gaya pill seperti prototype -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                    Background="#171C23" BorderBrush="#2A313B" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4C8DFF" Offset="0"/>
                                            <GradientStop Color="#2B5FD9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Foreground" Value="#9AA3B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F2C4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="Background" Value="#17335B"/>
            <Setter Property="BorderBrush" Value="#2B5FD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" BorderBrush="#171C23" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#2B5FD9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="SIGMA " FontWeight="SemiBold" Foreground="#EDEFF2" VerticalAlignment="Center"/>
                    <TextBlock Text="OPTIMIZER" FontWeight="SemiBold" Foreground="#4C8DFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PendingText" DockPanel.Dock="Right" Text="0 pending"
                           Foreground="#8891A0" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0B0E13" BorderBrush="#171C23" BorderThickness="0,0,1,0">
                <StackPanel x:Name="SidebarPanel" Margin="8,14"/>
            </Border>

            <!-- Main tweak list -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#171C23" BorderThickness="0,0,0,1" Padding="20,14,20,10">
                    <DockPanel>
                        <TextBlock x:Name="CategoryTitle" Text="CPU" FontSize="15" FontWeight="SemiBold" Foreground="#EDEFF2" VerticalAlignment="Center"/>
                        <Button x:Name="ApplyAllButton" DockPanel.Dock="Right" Content="Terapkan Semua"
                                Style="{StaticResource PrimaryButton}" Background="#171C23" Foreground="#565F6D"
                                Click="ApplyAllButton_Click"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="20,6,20,16">
                    <ItemsControl x:Name="TweakList"/>
                </ScrollViewer>
            </Grid>

            <!-- Log panel -->
            <Border Grid.Column="2" Background="#0B0E13" BorderBrush="#171C23" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="LOG AKTIVITAS" Foreground="#7A8290" FontSize="11.5" FontWeight="SemiBold" Margin="14,12,0,8"/>
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" Padding="14,0,14,10">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#8891A0" FontSize="10.8"
                                               FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Restart PC Sekarang" Margin="12" Padding="0,10"
                            Style="{StaticResource PrimaryButton}" Click="RestartButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B6B" Offset="0"/>
                                <GradientStop Color="#D9455E" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
